{
  "manifest_version": 3,
  "name": "Egress 自动网页查询",
  "version": "1.1.0",
  "description": "自动读取 IPHub、IPQualityScore 与 IPSuper 第三方检测结果，回传给 Egress 并清理临时标签。",
  "permissions": ["tabs", "scripting", "tabGroups"],
  "host_permissions": ["https://iphub.info/*", "https://www.ipqualityscore.com/*", "https://ipsuper.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "content_scripts": [{
    "matches": ["https://blackslience-reaper.github.io/egress-observatory/*", "http://127.0.0.1:4187/*", "http://localhost:4187/*"],
    "js": ["bridge.js"],
    "run_at": "document_idle"
  }],
  "minimum_chrome_version": "120"
}
